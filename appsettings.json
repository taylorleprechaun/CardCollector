{
  "Auth": {
    "CookieName": "CardCollectorAuth",
    "CookieExpirationHours": 8
  },
  "BanlistSettings": {
    "BaseUrl": "https://dawnbrandbots.github.io/yaml-yugi-limit-regulation/",
    "CacheTtlDays": 7,
    "EffectiveDateOverrides": {
      "2022-05-23": "2022-05-17",
      "2024-04-22": "2024-04-15"
    },
    "IndexUrl": "https://api.github.com/repos/DawnbrandBots/yaml-yugi-limit-regulation/contents/data/tcg"
  },
  "CardDataSettings": {
    "CacheTtlDays": 7,
    "ImageCacheTtlDays": 30,
    "PricingCacheTtlHours": 20,
    "YamlYugiUrl": "https://dawnbrandbots.github.io/yaml-yugi/cards.yaml"
  },
  "CatalogSync": {
    "MaxNewActionableItems": 250,
    "MinSourceRatio": 0.9,
    "SourceFailureWarningRuns": 3
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/cardcollector.db"
  },
  "LegacyMigration": {
    "LegacyDatabasePath": "Data/collection.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
