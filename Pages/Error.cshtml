@page
@model CardCollector.Pages.ErrorModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something went wrong - Card Collector</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <main class="container py-5">
        <div class="col-lg-7">
            <h1 class="h3 mb-3">Something went wrong</h1>
            <p>The page hit an error and couldn&rsquo;t finish. Try again; if it keeps happening, the server log has the details under the request ID below.</p>
            @if (!string.IsNullOrEmpty(Model.RequestID))
            {
                <p class="small text-muted">Request ID: <code>@Model.RequestID</code></p>
            }
            <a class="btn btn-primary" href="/">Back to the dashboard</a>
        </div>
    </main>
</body>
</html>
