@model CatalogReviewRowViewModel
@using CardCollector.Data.Models.Catalog
@using CardCollector.Rules.Catalog
@{
    var item = Model.Item;
    var rowId = $"review-row-{item.ID}";
    var moreId = $"review-more-{item.ID}";
    var detailsId = $"review-details-{item.ID}";
    var handlerURL = (string handler) => $"/Catalog/Review?handler={handler}&{Model.FilterParams}";
    var now = DateTime.UtcNow;
    var isOpen = item.Status == CatalogReviewItemStatus.Open;
    var primary = item.PrimaryAction;
    var canMap = item.Actions.Contains(CatalogReviewAction.MapToPrinting) && item.PrintingOptions.Count > 0;
    var canCreate = item.Actions.Contains(CatalogReviewAction.CreatePrinting) && item.CardOptions.Count > 0;
    var canCreateCard = item.Actions.Contains(CatalogReviewAction.CreateCard);
    var canReject = item.Actions.Contains(CatalogReviewAction.Reject);
    var simpleActions = new[] { CatalogReviewAction.Accept, CatalogReviewAction.Dismiss, CatalogReviewAction.Reopen };
    var placementPrimary = primary is CatalogReviewAction.MapToPrinting or CatalogReviewAction.CreatePrinting or CatalogReviewAction.CreateCard;
    var alternatives = new List<CatalogReviewAction>();
    if (canMap && primary != CatalogReviewAction.MapToPrinting) alternatives.Add(CatalogReviewAction.MapToPrinting);
    if (canCreate && primary != CatalogReviewAction.CreatePrinting) alternatives.Add(CatalogReviewAction.CreatePrinting);
    if (canCreateCard && primary != CatalogReviewAction.CreateCard) alternatives.Add(CatalogReviewAction.CreateCard);
    if (item.Actions.Contains(CatalogReviewAction.LinkKeepRetired)) alternatives.Insert(0, CatalogReviewAction.LinkKeepRetired);
    var printingLabel = $"{item.SetCode} {item.RarityName}".Trim();
    var title = item.CardName ?? item.Kind.GetDisplayName();

    async Task RenderMap(bool isPrimary)
    {
        <form method="post" class="d-grid d-md-flex align-items-md-center gap-2 flex-grow-1 ajax-form" data-ajax-target="@rowId">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@item.ID" />
            @if (!isPrimary)
            {
                <span class="small fw-medium cc-review-alt-label">Map to a printing</span>
            }
            <select id="review-map-@item.ID" name="printingID" class="form-select cc-review-picker" aria-label="Printing to map the product onto">
                @foreach (var option in item.PrintingOptions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
            <button type="submit" formaction="@handlerURL("Map")" class="btn @(isPrimary ? "btn-primary" : "btn-outline-primary")">Map</button>
        </form>
    }

    async Task RenderCreatePrinting(bool isPrimary)
    {
        var single = item.CardOptions.Count == 1 ? item.CardOptions[0] : null;
        <form method="post" class="d-grid d-md-flex align-items-md-center gap-2 flex-grow-1 ajax-form" data-ajax-target="@rowId">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@item.ID" />
            @if (!isPrimary)
            {
                <span class="small fw-medium cc-review-alt-label">Create the printing</span>
            }
            @if (single is not null)
            {
                <input type="hidden" name="cardID" value="@single.Value" />
                <button type="submit" formaction="@handlerURL("CreatePrinting")" class="btn @(isPrimary ? "btn-primary" : "btn-outline-primary")">
                    Create printing@(printingLabel.Length > 0 ? $" {printingLabel}" : string.Empty)
                </button>
                <span class="small text-muted">on @single.Label</span>
            }
            else
            {
                <select id="review-create-@item.ID" name="cardID" class="form-select cc-review-picker" aria-label="Card to create the printing on">
                    @foreach (var option in item.CardOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                <button type="submit" formaction="@handlerURL("CreatePrinting")" class="btn @(isPrimary ? "btn-primary" : "btn-outline-primary")">Create printing</button>
            }
        </form>
    }

    async Task RenderLinkKeepRetired()
    {
        <form method="post" class="d-grid d-md-flex align-items-md-center gap-2 flex-grow-1 ajax-form" data-ajax-target="@rowId">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@item.ID" />
            <span class="small fw-medium cc-review-alt-label">Keep it retired</span>
            <span class="small text-muted flex-grow-1">Links the product so the sync stops asking; the printing stays hidden.</span>
            <button type="submit" formaction="@handlerURL("LinkKeepRetired")" class="btn btn-outline-primary">Link, keep retired</button>
        </form>
    }

    async Task RenderCreateCard(bool isPrimary)
    {
        <form method="post" class="d-grid d-md-flex align-items-md-center gap-2 flex-grow-1 ajax-form" data-ajax-target="@rowId"
              data-confirm="Create a new catalog card named &quot;@item.CardName&quot;? It starts with only a name until a card source lists it.">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@item.ID" />
            @if (!isPrimary)
            {
                <span class="small fw-medium cc-review-alt-label">Add it as a card</span>
                <span class="small text-muted flex-grow-1">Starts with only a name until a card source lists it.</span>
            }
            <button type="submit" formaction="@handlerURL("CreateCard")" class="btn @(isPrimary ? "btn-primary" : "btn-outline-primary")">Create card</button>
            @if (isPrimary)
            {
                <span class="small text-muted">No catalog card has this name yet</span>
            }
        </form>
    }
}
<div class="list-group-item py-3" id="@rowId">
    <div class="d-flex gap-3">
        <div class="d-none d-sm-block">
            <partial name="_CardThumbnail" model='new CardThumbnailViewModel(item.ImageURLSmall, title, "No art")' />
        </div>
        <div class="flex-grow-1 min-width-0 d-grid gap-2">
            <div class="d-flex flex-wrap align-items-baseline column-gap-2 row-gap-1">
                <span class="fs-5 fw-semibold text-break">
                    @if (item.DisplayCardID is int cardID && item.CardName is not null)
                    {
                        <a href="/Card?id=@cardID">@item.CardName</a>
                    }
                    else
                    {
                        @title
                    }
                </span>
                @if (Model.ShowKind)
                {
                    <span class="cc-chip">@item.Kind.GetDisplayName()</span>
                }
                @if (!isOpen)
                {
                    <span class="cc-chip">@item.Status.GetDisplayName()</span>
                }
                <span class="small text-muted ms-sm-auto text-nowrap" title="First seen @item.FirstDetectedUTC.ToString("MMM d, yyyy")">
                    First seen @item.FirstDetectedUTC.ToRelativeDate(now)@(item.DetectionCount > 1 ? $" · reported {item.DetectionCount}×" : string.Empty)
                </span>
            </div>

            @if (item.SetCode is not null || item.RarityName is not null || item.PrintVariant is not null || item.ProductID is not null)
            {
                <div class="d-flex flex-wrap gap-1">
                    @if (item.SetCode is not null)
                    {
                        <span class="cc-chip cc-chip-code">@item.SetCode</span>
                    }
                    @if (item.RarityName is not null)
                    {
                        <span class="cc-chip">@item.RarityName</span>
                    }
                    @if (item.PrintVariant is not null)
                    {
                        <span class="cc-chip">@item.PrintVariant</span>
                    }
                    @if (item.ProductID is int productID)
                    {
                        <a class="cc-chip" href="@TCGPlayerLinks.ProductURL(productID)" target="_blank" rel="noopener" title="Open on TCGPlayer">TCGPlayer #@productID <i class="bi bi-box-arrow-up-right"></i></a>
                    }
                </div>
            }

            <div class="cc-review-headline @(item.IsActionable && isOpen ? "cc-review-headline--actionable" : "")">
                @if (item.IsActionable && isOpen)
                {
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                }
                <span class="text-break">@item.Headline</span>
            </div>

            @if (item.ResolvedUTC is DateTime resolved)
            {
                <div class="small text-muted">@item.Resolution &middot; @resolved.ToString("MMM d, yyyy")</div>
            }
            @if (!string.IsNullOrEmpty(item.ErrorMessage))
            {
                <div class="alert alert-danger small py-1 px-2 mb-0" role="alert">@item.ErrorMessage</div>
            }
        </div>
    </div>

    @if (primary is not null || canReject || alternatives.Count > 0 || item.Details.Count > 0)
    {
        <div class="cc-review-decide">
            @if (primary is not null || canReject)
            {
                <div class="d-flex flex-column flex-md-row flex-md-wrap align-items-md-center gap-2">
                    @if (primary is CatalogReviewAction action && simpleActions.Contains(action))
                    {
                        var (handler, label) = action switch
                        {
                            CatalogReviewAction.Accept => ("Accept", item.AcceptLabel ?? "Accept"),
                            CatalogReviewAction.Dismiss => ("Dismiss", "Dismiss"),
                            _ => ("Reopen", "Reopen")
                        };
                        <form method="post" class="d-grid d-md-flex ajax-form" data-ajax-target="@rowId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.ID" />
                            <button type="submit" formaction="@handlerURL(handler)"
                                    class="btn @(action == CatalogReviewAction.Accept ? "btn-primary" : "btn-outline-secondary")">@label</button>
                        </form>
                    }
                    else if (primary == CatalogReviewAction.MapToPrinting)
                    {
                        await RenderMap(isPrimary: true);
                    }
                    else if (primary == CatalogReviewAction.CreatePrinting)
                    {
                        await RenderCreatePrinting(isPrimary: true);
                    }
                    else if (primary == CatalogReviewAction.CreateCard)
                    {
                        await RenderCreateCard(isPrimary: true);
                    }

                    @if (canReject)
                    {
                        <form method="post" class="d-grid d-md-flex ms-md-auto ajax-form" data-ajax-target="@rowId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.ID" />
                            <button type="submit" formaction="@handlerURL("Reject")" class="btn @(placementPrimary || primary is null ? "btn-link text-body-secondary" : "btn-outline-secondary")">@item.RejectLabel</button>
                        </form>
                    }
                </div>
            }

            @if (alternatives.Count > 0)
            {
                <div>
                    <button type="button" class="btn btn-link btn-sm p-0 list-group-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#@moreId"
                            aria-expanded="false" aria-controls="@moreId"><span class="chevron">&#9656;</span> Other ways to resolve</button>
                    <div class="collapse" id="@moreId">
                        <div class="cc-review-alternatives">
                            @foreach (var alternative in alternatives)
                            {
                                if (alternative == CatalogReviewAction.MapToPrinting)
                                {
                                    await RenderMap(isPrimary: false);
                                }
                                else if (alternative == CatalogReviewAction.CreatePrinting)
                                {
                                    await RenderCreatePrinting(isPrimary: false);
                                }
                                else if (alternative == CatalogReviewAction.LinkKeepRetired)
                                {
                                    await RenderLinkKeepRetired();
                                }
                                else
                                {
                                    await RenderCreateCard(isPrimary: false);
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            @if (item.Details.Count > 0)
            {
                <div>
                    <button type="button" class="btn btn-link btn-sm p-0 list-group-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#@detailsId"
                            aria-expanded="false" aria-controls="@detailsId"><span class="chevron">&#9656;</span> What the sync reported</button>
                    <div class="collapse" id="@detailsId">
                        <dl class="cc-details-grid">
                            @foreach (var detail in item.Details)
                            {
                                <dt>@detail.Key</dt>
                                <dd class="text-break">@detail.Value</dd>
                            }
                        </dl>
                    </div>
                </div>
            }
        </div>
    }
</div>
