@model CardCollector.ViewModels.DeckSectionViewModel
@using CardCollector.Extensions
@using CardCollector.Models
@{
    var title = (string)ViewData["Title"]!;
    var returnUrl = Uri.EscapeDataString((string)ViewData["ReturnURL"]!);
    var columns = (int)ViewData["Columns"]!;
    var cardStatuses = ViewData["CardStatuses"] as IReadOnlyDictionary<int, DeckLegalityCardStatus>;
}

<section class="mb-4" aria-labelledby="deck-section-@title">
    <h2 class="h5" id="deck-section-@title">@title <span class="text-muted">(@Model.Count)</span></h2>

    @if (Model.Cards.Count == 0)
    {
        <p class="text-muted">No cards.</p>
    }
    else
    {
        <div class="cc-deck-grid" style="--cc-deck-columns: @columns">
            @foreach (var card in Model.Cards)
            {
                var status = cardStatuses?.GetValueOrDefault(card.CardID);
                for (var copy = 0; copy < card.Quantity; copy++)
                {
                    if (card.IsUnknown)
                    {
                        <div class="cc-deck-tile cc-deck-tile-empty" title="Unknown card (passcode @card.CardID)">
                            <span>Unknown card</span>
                            <span>@card.CardID</span>
                        </div>
                    }
                    else if (card.ImageURL is null)
                    {
                        <a class="cc-deck-tile cc-deck-tile-empty @(status?.IsViolation == true ? "cc-deck-tile-violation" : string.Empty)" href="/Card?id=@card.CardID&returnURL=@returnUrl">
                            <span>@card.Card!.Name</span>
                            <partial name="_DeckLegalityBadge" model="status" />
                        </a>
                    }
                    else
                    {
                        <a class="cc-deck-tile @(status?.IsViolation == true ? "cc-deck-tile-violation" : string.Empty)" href="/Card?id=@card.CardID&returnURL=@returnUrl">
                            <img src="@card.ImageURL" alt="@card.Card!.Name" width="168" height="246" loading="lazy" />
                            <partial name="_DeckLegalityBadge" model="status" />
                        </a>
                    }
                }
            }
        </div>
    }
</section>
