@page
@model CardCollector.Pages.Tournaments.Events.DetailsModel
@using System.Globalization
@using CardCollector.Data.Models
@using CardCollector.Rules
@using CardCollector.ViewModels
@{
    var detail = Model.Detail!;
    var tournamentEvent = detail.Event;
    ViewData["Title"] = $"{tournamentEvent.Location} Event";

    var finishText = tournamentEvent.Finish?.ToString() ?? tournamentEvent.FinishNote;
    var hasDecklistURL = !string.IsNullOrWhiteSpace(tournamentEvent.DecklistURL);
    var hasRounds = detail.Summary.RoundCount > 0;
}

<nav aria-label="breadcrumb" class="mb-2">
    <a href="/Tournaments/Events" class="small"><i class="bi bi-arrow-left me-1"></i>All events</a>
</nav>

<div class="mb-3">
    <h1 class="mb-1 text-break">@tournamentEvent.Location</h1>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted">@tournamentEvent.Date.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</span>
        <span class="badge-neutral">@tournamentEvent.EventType.GetDisplayName()</span>
    </div>
</div>

<div class="cc-table-card p-3 mb-4">
    <dl class="row mb-0 gy-2">
        <dt class="col-sm-3">Format</dt>
        <dd class="col-sm-9 mb-0">
            @if (detail.Format is null)
            {
                <span class="text-muted">@FormatRules.NO_FORMAT_NAME</span>
            }
            else
            {
                <div class="fw-semibold">@detail.Format.Name</div>
                <partial name="_FormatStrategyChips" model="detail.Format" />
            }
        </dd>

        <dt class="col-sm-3">Deck</dt>
        <dd class="col-sm-9 mb-0">
            <span class="text-break">@tournamentEvent.DeckName</span>
            @if (hasDecklistURL)
            {
                <div><a href="@tournamentEvent.DecklistURL" target="_blank" rel="noopener noreferrer" class="text-break">Decklist <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i></a></div>
            }
            <div><partial name="_EventDeckLinks" model="new EventDeckLinksViewModel(tournamentEvent, detail.OtherUnlinkedEventsWithSameURL)" /></div>
        </dd>

        <dt class="col-sm-3">Finish</dt>
        <dd class="col-sm-9 mb-0">
            @if (finishText is null && tournamentEvent.Players is null)
            {
                <span class="text-muted">&mdash;</span>
            }
            else
            {
                <span>@(finishText ?? "?")@(tournamentEvent.Players is { } players ? $" of {players} players" : string.Empty)</span>
            }
            @if (!string.IsNullOrWhiteSpace(tournamentEvent.TopCut))
            {
                <span class="text-muted"> &middot; @tournamentEvent.TopCut</span>
            }
        </dd>

        @if (!string.IsNullOrWhiteSpace(tournamentEvent.Notes))
        {
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9 mb-0 text-break cc-pre-line">@tournamentEvent.Notes</dd>
        }
    </dl>
</div>

<h2 class="h4" id="rounds">Rounds</h2>

<p class="mb-3" id="matchSummary" role="status" hidden="@(!hasRounds)">
    <partial name="_MatchSummary" model="detail.Summary" />
</p>

@if (Model.AreRoundsOutOfOrder)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
        <span>These rounds aren&rsquo;t in round order.</span>
        <form method="post" asp-page-handler="SortMatches" asp-route-id="@Model.ID">
            <button type="submit" class="btn btn-warning btn-sm cc-tap-target">Sort by round</button>
        </form>
    </div>
}

<div class="cc-table-card cc-match-form mb-3">
    <button type="button" class="btn w-100 d-flex justify-content-between align-items-center fw-semibold cc-add-round-toggle"
            data-bs-toggle="collapse" data-bs-target="#addRoundPanel" aria-expanded="false" aria-controls="addRoundPanel">
        <span><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add round</span>
        <i class="bi bi-chevron-down" aria-hidden="true"></i>
    </button>
    <div class="collapse" id="addRoundPanel">
        <form method="post" asp-page-handler="AddMatch" asp-route-id="@Model.ID" class="p-3 pt-2" data-match-form="add">
            <partial name="_MatchFormFields" model='new MatchFormViewModel { IDPrefix = "add", InitialRound = detail.Summary.NextRound }' />
            <div class="mt-3">
                <button type="submit" class="btn btn-primary cc-tap-target">Add round</button>
            </div>
        </form>
    </div>
</div>

<div class="alert alert-info" id="matchEmpty" hidden="@hasRounds">No rounds recorded for this event.</div>

<div class="list-group cc-table-card" id="matchList" hidden="@(!hasRounds)">
    @foreach (var round in tournamentEvent.Matches)
    {
        <partial name="_MatchRow" model="round" />
    }
</div>

<datalist id="matchOpponentOptions">
    @foreach (var opponent in Model.OpponentDecks)
    {
        <option value="@opponent"></option>
    }
</datalist>

<datalist id="matchRoundOptions">
    <option value="Top 8"></option>
    <option value="Top 4"></option>
    <option value="Finals"></option>
</datalist>

<!-- Edit Round Modal -->
<div class="modal fade" id="editMatchModal" tabindex="-1" aria-labelledby="editMatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-sm-down modal-dialog-scrollable">
        <div class="modal-content cc-match-form">
            <form method="post" asp-page-handler="EditMatch" asp-route-id="@Model.ID" data-match-form="edit">
                <div class="modal-header">
                    <h5 class="modal-title" id="editMatchModalLabel">Edit round</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <partial name="_MatchFormFields" model='new MatchFormViewModel { IDPrefix = "edit" }' />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary cc-tap-target" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary cc-tap-target">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Round Modal -->
<div class="modal fade" id="deleteMatchModal" tabindex="-1" aria-labelledby="deleteMatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cc-match-form">
            <form method="post" asp-page-handler="DeleteMatch" asp-route-id="@Model.ID" data-match-form="delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteMatchModalLabel">Delete round</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div data-match-errors class="alert alert-danger" role="alert" hidden>
                        <ul class="mb-0"></ul>
                    </div>
                    <input type="hidden" name="matchID" id="deleteMatchID" />
                    <p class="mb-0">Delete <strong id="deleteMatchName" class="text-break"></strong>? This can&rsquo;t be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary cc-tap-target" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger cc-tap-target">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="~/Pages/Tournaments/_DeckImportModal.cshtml" model="Model.DeckOptions" />

@section Scripts {
    <script src="~/js/event-matches.js" asp-append-version="true"></script>
    <script src="~/js/deck-import.js" asp-append-version="true"></script>
}
