@page
@model CardCollector.Pages.Tournaments.DecksModel
@{
    ViewData["Title"] = "Decks";
    var hasDecks = Model.Decks.Count > 0;
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1>Decks</h1>
</div>

<p class="text-muted mb-3">Deck lists imported from DuelingBook. To add one, use <strong>Add deck</strong> on an event.</p>

@if (!hasDecks)
{
    <div class="alert alert-info text-center py-5">
        <h4>No decks yet</h4>
        <p class="mb-0">Open an event and use <strong>Add deck</strong> to paste a YDKe code or YDK file.</p>
    </div>
}
else
{
    <div class="cc-table-card d-none d-md-block">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col" class="text-end">Main</th>
                    <th scope="col" class="text-end">Extra</th>
                    <th scope="col" class="text-end">Side</th>
                    <th scope="col" class="text-end">Events</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var deck in Model.Decks)
                {
                    <tr>
                        <td><a class="fw-semibold text-break" href="/Tournaments/Decks/Details?id=@deck.ID">@deck.Name</a></td>
                        <td class="text-end">@deck.MainCount</td>
                        <td class="text-end">@deck.ExtraCount</td>
                        <td class="text-end">@deck.SideCount</td>
                        <td class="text-end">@deck.EventCount</td>
                        <td class="text-end"><partial name="_DeckActions" model="deck" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="list-group cc-table-card d-md-none">
        @foreach (var deck in Model.Decks)
        {
            <div class="list-group-item">
                <div class="d-flex flex-column gap-2 py-1">
                    <div>
                        <a class="fw-semibold text-break" href="/Tournaments/Decks/Details?id=@deck.ID">@deck.Name</a>
                        <div class="text-muted small">
                            @deck.MainCount main &middot; @deck.ExtraCount extra &middot; @deck.SideCount side
                            &middot; @deck.EventCount @(deck.EventCount == 1 ? "event" : "events")
                        </div>
                    </div>
                    <partial name="_DeckActions" model="deck" />
                </div>
            </div>
        }
    </div>
}

<!-- Rename Modal -->
<div class="modal fade" id="renameDeckModal" tabindex="-1" aria-labelledby="renameDeckModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <form method="post" asp-page-handler="Rename">
                <div class="modal-header">
                    <h5 class="modal-title" id="renameDeckModalLabel">Rename deck</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="renameDeckID" />
                    <div class="mb-3">
                        <label for="renameDeckName" class="form-label">Name</label>
                        <input type="text" name="name" id="renameDeckName" class="form-control" maxlength="@CardCollector.Rules.DeckRules.MAX_NAME_LENGTH" autocomplete="off" required />
                    </div>
                    <div class="mb-0">
                        <label for="renameDeckNotes" class="form-label">Notes</label>
                        <textarea name="notes" id="renameDeckNotes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteDeckModal" tabindex="-1" aria-labelledby="deleteDeckModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteDeckModalLabel">Delete deck</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteDeckID" />
                    <p class="mb-0">Delete <strong id="deleteDeckName" class="text-break"></strong>?<span id="deleteDeckEvents"></span> This can&rsquo;t be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/decks.js" asp-append-version="true"></script>
}
