@page
@model CardCollector.Pages.Tournaments.EventsModel
@using System.Globalization
@using CardCollector.Data.Models
@using CardCollector.Services
@{
    ViewData["Title"] = "Events";

    string DateText(DateOnly date) => date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    string RecordText(EventListItemViewModel item) => item.Record.Total == 0 ? "—" : item.Record.ToString();

    var isEditing = Model.Input.ID != 0;
    var eventTypes = Enum.GetValues<EventType>();
    var hasResults = Model.Results.Items.Count > 0;
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1>Events</h1>
    <button type="button" class="btn btn-primary btn-sm" onclick="openEventModal(null)">
        <i class="bi bi-plus-lg me-1"></i>Add Event
    </button>
</div>

<p class="text-muted mb-3">Tournaments you&rsquo;ve played. An event&rsquo;s format is worked out from its date.</p>

<form method="get" class="cc-table-card p-3 mb-4" aria-label="Filter events">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-lg-2">
            <label for="filterDateFrom" class="form-label small mb-1">From</label>
            <input type="text" id="filterDateFrom" name="dateFrom" class="form-control form-control-sm cc-date-picker"
                   value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-2">
            <label for="filterDateTo" class="form-label small mb-1">To</label>
            <input type="text" id="filterDateTo" name="dateTo" class="form-control form-control-sm cc-date-picker"
                   value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-2">
            <label for="filterFormat" class="form-label small mb-1">Format</label>
            <select id="filterFormat" name="formatID" class="form-select form-select-sm">
                <option value="">All formats</option>
                @foreach (var format in Model.Formats)
                {
                    <option value="@format.ID" selected="@(Model.FormatID == format.ID)">@format.Name</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label for="filterType" class="form-label small mb-1">Type</label>
            <select id="filterType" name="type" class="form-select form-select-sm">
                <option value="">All types</option>
                @foreach (var type in eventTypes)
                {
                    <option value="@type" selected="@(Model.Type == type)">@type.GetDisplayName()</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label for="filterLocation" class="form-label small mb-1">Location</label>
            <input type="text" id="filterLocation" name="location" class="form-control form-control-sm"
                   value="@Model.Location" autocomplete="off" />
        </div>
        <div class="col-6 col-lg-2">
            <label for="filterDeck" class="form-label small mb-1">Deck</label>
            <input type="text" id="filterDeck" name="deck" class="form-control form-control-sm"
                   value="@Model.Deck" autocomplete="off" />
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary btn-sm">Apply</button>
        @if (Model.HasActiveFilters)
        {
            <a href="/Tournaments/Events" class="btn btn-outline-secondary btn-sm">Clear</a>
        }
    </div>
</form>

@if (!hasResults)
{
    <div class="alert alert-info text-center py-5">
        @if (Model.HasActiveFilters)
        {
            <h4>No matching events</h4>
            <p class="mb-0">Try loosening the filters, or <a href="/Tournaments/Events">clear them</a>.</p>
        }
        else
        {
            <h4>No events yet</h4>
            <p class="mb-0">Use <strong>Add Event</strong> to record your first tournament.</p>
        }
    </div>
}
else
{
    <p class="text-muted small mb-2" role="status">@Model.Results.TotalCount @(Model.Results.TotalCount == 1 ? "event" : "events")</p>

    <div class="cc-table-card d-none d-md-block">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Event</th>
                    <th scope="col">Deck</th>
                    <th scope="col">Finish</th>
                    <th scope="col">Record</th>
                    <th scope="col">Format</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    <tr>
                        <td class="text-nowrap">@DateText(item.Event.Date)</td>
                        <td>
                            <a class="fw-semibold text-break" href="/Tournaments/Events/Details?id=@item.Event.ID">@item.Event.Location</a>
                            <div><span class="badge-neutral">@item.Event.EventType.GetDisplayName()</span></div>
                        </td>
                        <td class="text-break">
                            @item.Event.DeckName
                            <div><partial name="_EventDeckLinks" model="new EventDeckLinksViewModel(item.Event, item.OtherUnlinkedEventsWithSameURL)" /></div>
                        </td>
                        <td class="text-nowrap"><partial name="_EventFinish" model="item" /></td>
                        <td class="text-nowrap">@RecordText(item)</td>
                        <td>@item.FormatName</td>
                        <td class="text-end"><partial name="_EventActions" model="item" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="list-group cc-table-card d-md-none">
        @foreach (var item in Model.Results.Items)
        {
            <div class="list-group-item">
                <div class="d-flex flex-column gap-2 py-1">
                    <div>
                        <a class="fw-semibold text-break" href="/Tournaments/Events/Details?id=@item.Event.ID">@item.Event.Location</a>
                        <div class="text-muted small">@DateText(item.Event.Date) &middot; @item.FormatName</div>
                        <div class="mt-1"><span class="badge-neutral">@item.Event.EventType.GetDisplayName()</span></div>
                    </div>
                    <div class="small">
                        <div><span class="text-muted">Deck:</span> <span class="text-break">@item.Event.DeckName</span></div>
                        <div><partial name="_EventDeckLinks" model="new EventDeckLinksViewModel(item.Event, item.OtherUnlinkedEventsWithSameURL)" /></div>
                        <div><span class="text-muted">Finish:</span> <partial name="_EventFinish" model="item" /></div>
                        <div><span class="text-muted">Record:</span> @RecordText(item)</div>
                    </div>
                    <partial name="_EventActions" model="item" />
                </div>
            </div>
        }
    </div>

    <div class="mt-3">
        <partial name="_Pagination" model='new PaginationViewModel
        {
            AriaLabel = "Events pagination",
            PageName = "/Tournaments/Events",
            PageNumber = Model.PageNumber,
            PageSize = Model.PageSize,
            TotalPages = Model.Results.TotalPages,
            HasPreviousPage = Model.Results.HasPreviousPage,
            HasNextPage = Model.Results.HasNextPage,
            AdditionalParams = Model.GetFilterParams()
        }' />
    </div>
}

<!-- Add / Edit Modal -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true"
     data-open-on-load="@(Model.ShowEventModal ? "true" : "false")">
    <div class="modal-dialog modal-lg modal-fullscreen-sm-down modal-dialog-scrollable">
        <div class="modal-content">
            <form id="eventForm" method="post" asp-page-handler="Save" asp-all-route-data="Model.GetReturnRouteData()">
                <div class="modal-header">
                    <h5 class="modal-title" id="eventModalLabel">@(isEditing ? "Edit Event" : "Add Event")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.Errors.Count > 0)
                    {
                        <div class="alert alert-danger" id="eventErrors" role="alert">
                            <ul class="mb-0">
                                @foreach (var error in Model.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <input type="hidden" asp-for="Input.ID" />

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Input.Date" class="form-label">Date</label>
                            <input asp-for="Input.Date" class="form-control form-control-sm cc-date-picker" />
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Input.EventType" class="form-label">Event type</label>
                            <select asp-for="Input.EventType" class="form-select form-select-sm">
                                @foreach (var type in eventTypes)
                                {
                                    <option value="@type">@type.GetDisplayName()</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Location" class="form-label">Location</label>
                        <input asp-for="Input.Location" class="form-control" list="eventLocationOptions"
                               maxlength="@EventRules.MAX_LOCATION_LENGTH" autocomplete="off" />
                        <datalist id="eventLocationOptions">
                            @foreach (var location in Model.Locations)
                            {
                                <option value="@location"></option>
                            }
                        </datalist>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.DeckName" class="form-label">Deck played</label>
                        <input asp-for="Input.DeckName" class="form-control" list="eventDeckOptions"
                               maxlength="@EventRules.MAX_DECK_NAME_LENGTH" autocomplete="off" />
                        <datalist id="eventDeckOptions">
                            @foreach (var deckName in Model.DeckNames)
                            {
                                <option value="@deckName"></option>
                            }
                        </datalist>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.DecklistURL" class="form-label">Decklist URL <span class="text-muted">(optional)</span></label>
                        <input asp-for="Input.DecklistURL" type="url" class="form-control"
                               maxlength="@EventRules.MAX_URL_LENGTH" autocomplete="off" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <label asp-for="Input.Finish" class="form-label">Finish</label>
                            <input asp-for="Input.Finish" type="number" min="1" class="form-control" />
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Input.Players" class="form-label">Players</label>
                            <input asp-for="Input.Players" type="number" min="1" class="form-control" />
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Input.TopCut" class="form-label">Top cut</label>
                            <input asp-for="Input.TopCut" class="form-control" autocomplete="off" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.FinishNote" class="form-label">Finish note <span class="text-muted">(optional, e.g. a range like 50&ndash;70)</span></label>
                        <input asp-for="Input.FinishNote" class="form-control" autocomplete="off" />
                    </div>

                    <div class="mb-0">
                        <label asp-for="Input.Notes" class="form-label">Notes</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteEventModal" tabindex="-1" aria-labelledby="deleteEventModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete" asp-all-route-data="Model.GetReturnRouteData()">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteEventModalLabel">Delete event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteEventID" />
                    <p class="mb-0">Delete the event at <strong id="deleteEventName" class="text-break"></strong><span id="deleteEventRounds"></span>? This can&rsquo;t be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="_DeckImportModal" model="Model.DeckOptions" />

@section Scripts {
    <script src="~/js/events.js" asp-append-version="true"></script>
    <script src="~/js/deck-import.js" asp-append-version="true"></script>
}
