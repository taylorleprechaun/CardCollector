@model CardCollector.ViewModels.EventDeckLinksViewModel
@{
    var tournamentEvent = Model.Event;
    var hasDeck = tournamentEvent.DeckID is not null;
    var hasUrl = !string.IsNullOrWhiteSpace(tournamentEvent.DecklistURL);
}
<span class="d-inline-flex flex-wrap align-items-center column-gap-3">
    @if (tournamentEvent.DeckID is { } deckID)
    {
        <a class="small" href="/Tournaments/Decks/Details?id=@deckID">View deck</a>
    }
    <button type="button"
            class="btn btn-link btn-sm p-0 cc-tap-target"
            data-event-id="@tournamentEvent.ID"
            data-event-deck="@tournamentEvent.DeckName"
            data-event-has-deck="@(hasDeck ? "true" : "false")"
            data-event-others="@Model.OtherUnlinkedEventsWithSameURL"
            data-event-url="@tournamentEvent.DecklistURL"
            onclick="openDeckImportModal(this)">
        @(hasDeck ? "Change" : hasUrl ? "Import deck" : "Add deck")
    </button>
</span>
